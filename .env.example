# ==============================================================================
# AI Quality Evaluation & Automated Regression Testing Platform - Configuration
# ==============================================================================

# 1. Primary AI Provider Configuration
# Supported providers: "auto", "openai", "openrouter", "ollama", "offline"
LLM_PROVIDER=auto

# Model Identifier to evaluate (e.g. gpt-4o, llama3, mistral, claude-3-5-sonnet)
LLM_MODEL=llama3

# Optional custom base URL for OpenAI-compatible proxies (e.g., vLLM, LiteLLM, Groq, OpenRouter)
# Default for OpenAI: https://api.openai.com/v1/chat/completions
# Default for OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_BASE_URL=

# API Key for OpenAI or OpenRouter (Leave blank for Ollama or Offline Deterministic mode)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# 2. Local Ollama Configuration (No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 3. Dedicated Evaluation Judge Configuration (Optional)
# If left blank, the platform automatically uses transparent deterministic heuristic judging
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# 4. Evaluation & Quality Gate Thresholds
# Minimum overall score (0.0 to 1.0) required for a test case to PASS
PASS_THRESHOLD=0.70

# Minimum groundedness score (0.0 to 1.0) before flagging as a hallucination trap
GROUNDEDNESS_THRESHOLD=0.60

# Regression sensitivity delta: Score drop threshold that triggers a regression warning
REGRESSION_THRESHOLD_DELTA=0.05

# 5. Database & Persistence
DATABASE_URL=sqlite:///./ai_eval.db

# 6. Service Networking & URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
