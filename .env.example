# ==============================================================================
# AI Quality Evaluation & Automated Regression Testing Platform - Configuration
# ==============================================================================

# 1. Primary AI Provider Configuration
# Supported providers: "gemini", "groq", "openai", "openrouter", "ollama", "offline", "auto"
LLM_PROVIDER=auto

# Model Identifier to evaluate (e.g. gemini-3.8-flash, openai/gpt-oss-20b, gpt-4o-mini, llama3)
LLM_MODEL=gemini-3.8-flash

# Auto Provider Fallback Priority (comma-separated evaluation sequence)
LLM_AUTO_PROVIDER_ORDER=gemini,groq,openrouter,openai,ollama

# 2. Google Gemini Configuration (OpenAI-Compatible Endpoint)
# Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 3. Groq Cloud Configuration (OpenAI-Compatible Endpoint)
# Endpoint: https://api.groq.com/openai/v1/chat/completions
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. OpenAI / OpenRouter Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional global custom base URL for OpenAI-compatible proxies (e.g., vLLM, LiteLLM)
LLM_BASE_URL=

# 5. Local Ollama Configuration (No API Key Required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# 6. Dedicated Evaluation Judge Configuration (Optional)
# If left blank, the platform automatically uses transparent deterministic heuristic judging
# Supported live judges: "gemini", "groq", "openai", "openrouter", "ollama"
# (Falls back to the provider's API key if JUDGE_API_KEY is left empty)
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_API_KEY=

# 7. Evaluation & Quality Gate Thresholds
# Minimum overall score (0.0 to 1.0) required for a test case to PASS
PASS_THRESHOLD=0.70

# Minimum groundedness score (0.0 to 1.0) before flagging as a hallucination trap
GROUNDEDNESS_THRESHOLD=0.60

# Regression sensitivity delta: Score drop threshold that triggers a regression warning
REGRESSION_THRESHOLD_DELTA=0.05

# 8. Database & Persistence
DATABASE_URL=sqlite:///./ai_eval.db

# 9. Service Networking & URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
